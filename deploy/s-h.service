[Unit]
Description=S-H secondhand clothing store
After=network.target

[Service]
Type=simple
User=s-h
Group=s-h
WorkingDirectory=/opt/s-h
EnvironmentFile=/etc/s-h/s-h.env
ExecStart=/usr/bin/env node /opt/s-h/server.js
Restart=on-failure
RestartSec=5
StateDirectory=s-h
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/s-h

[Install]
WantedBy=multi-user.target